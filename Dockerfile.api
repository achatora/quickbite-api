# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN go build -o /app/quickbite-api ./cmd/api

# Run stage
FROM alpine:latest

WORKDIR /root/

# Copy binary from builder
COPY --from=builder /app/quickbite-api .

# Expose port
EXPOSE 8081

# Run the application
CMD ["./quickbite-api"]
